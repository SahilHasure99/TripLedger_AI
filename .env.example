# Optional LLM provider. Leave blank to use the local deterministic planner.
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-1.5-flash

# Optional live-data integrations (leave blank to use sample data).
FLIGHT_API_KEY=your_flight_api_key_here
HOTEL_API_KEY=your_hotel_api_key_here
WEATHER_API_KEY=your_weather_api_key_here

LOG_LEVEL=INFO

# TripLedger AI backend (REQUIRED for API authentication)
APP_ENV=development
DATABASE_URL=sqlite:///./data/tripledger.db
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ISSUER=tripledger-ai
TOKEN_EXPIRE_MINUTES=60

# PayPal Sandbox credentials. Never use production credentials during development.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Production controls: use Redis for distributed auth rate limiting.
REDIS_URL=redis://localhost:6379/0
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PUBLIC_APP_URL=http://localhost:8000
